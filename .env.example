# ============================================================================
# 환경변수 — 변수명만 담는다 (SEC-05)
#
# 이 파일은 커밋되고 값은 커밋되지 않는다. 로컬은 `.env.local`에, 배포는
# Vercel 환경변수에 넣는다. 로컬 값은 `npm run db:status`가 출력한다
# (API_URL → URL, ANON_KEY → 공개 키).
#
# ★ service_role(SECRET_KEY) 키를 이 파일에도, .env.local에도 넣지 않는다.
#   그 키는 RLS를 통째로 우회하므로 조회 경로가 한 번이라도 쓰면 그 뒤의 모든
#   초록색이 무엇을 증명하는지 알 수 없게 된다(SEC-06, DOC-011 §4.0 Q-01).
#   ★ ~~P5의 시세 수집 배치가 처음으로 요구할 때 서버 전용 변수로 별도 등재한다~~
#   → **영구히 등재되지 않는다** (AQ-57 = ⓐ, P5a 컷 0). 그 배치는 이미 구현됐고
#   (P5a 컷 3) `service_role`을 요구하지 «않는다» — GoTrue 계정으로 로그인해
#   `authenticated`로 돈다. 미결이라 미루는 것이 아니라 **필요하지 않다는 답**이
#   나왔다(DOC-013 §5.1 · `src/lib/db/batch.ts`).
#
# 다섯 변수는 모두 `src/lib/db/env.ts`에서만 읽는다 — 그 파일이 유일한 리더다
# (이 수는 아래 항목 수와 같아야 한다. P5b 컷 1에 셋, P5a 컷 3에 둘이 더해졌다).
# ============================================================================

# Supabase 프로젝트 API URL. 브라우저 번들에 포함된다.
NEXT_PUBLIC_SUPABASE_URL=

# 공개(anon) 키. 브라우저 번들에 포함된다 — 비밀이 아니다.
# 이 키만으로 얻을 수 있는 권한은 `anon` 롤이며, anon에는 어떤 테이블 권한도
# 부여하지 않았다(DOC-010 §7). 세션이 있어야 `authenticated`가 되고,
# 세션은 초대된 사용자의 로그인으로만 생긴다(SEC-03, 공개 가입 비활성).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 시세 배치 엔드포인트(`/api/cron/prices`)의 비밀 토큰 — SEC-04, DOC-013 §6.3.
# **서버 전용이며 비밀이다.** 위의 둘과 달리 브라우저 번들에 실리지 않는다
# (`NEXT_PUBLIC_` 접두사가 없다).
#
# 운영에서는 Vercel 환경변수(production)에 넣고, Vercel이 cron 호출에
# `Authorization: Bearer <값>`으로 자동 첨부한다. 16자 이상 난수.
#
# ★ 빈 문자열로 두지 않는다 — 빈 값이면 `Bearer `로 시작하는 **모든** 헤더가
#   일치하므로 인증이 조용히 사라진다. `env.ts`가 빈 문자열을 부재와 함께 던지고
#   라우트는 그것을 500으로 답한다(DOC-011 §7.1 CR-06 — 401이 아니다).
#
# 로컬에서는 **선택**이다. 채우지 않으면 그 엔드포인트가 500을 내고 나머지 앱은
# 정상이다. 채우면 `curl -H "Authorization: Bearer <값>" localhost:3000/api/cron/prices`로
# 실제 수집(200 + `CronResult`)까지 확인할 수 있다 — 아래 둘도 함께 필요하다.
CRON_SECRET=

# ---------------------------------------------------------------------------
# 배치가 로그인할 계정 — AQ-57 = ⓐ (DOC-013 §11), DOC-013 §7 · §10.3 (P5a 컷 3·5)
#
# ★ 운영은 «전용 계정이 아니라» 민서 자신의 계정이다(ⓐ′ — DOC-013 §10.3).
#   로컬·e2e만 전용 시드 계정을 쓰며 그 어긋남은 의도다.
#
# 배치가 «GoTrue 계정으로» 로그인해 `authenticated`로 돈다. `service_role`
# (신형 `SECRET_KEY`)을 도입하지 «않기» 위한 선택이며, 그 결정 덕분에
# **RLS 정책 32개가 배치 경로에도 적용된다** — `service_role`은 `rolbypassrls = t`라
# 그 32개를 통째로 우회하고, 그 사실은 정책 테스트가 전부 초록인 채로 참이 된다.
#
# ★ 이 둘이 없으면 라우트가 **500 `INTERNAL` + `rule: 'CR-10'`**으로 답한다
#   (503이 아니다 — 공급자는 등록되어 있고 고칠 것이 환경변수다. DOC-011 §7.1 CR-10).
#   부재한 변수의 «이름»은 서버 로그에만 남고 응답 본문에는 실리지 않는다.
#
# ★★ **비밀번호 값을 어느 문서·커밋에도 적지 않는다**(SEC-05 — 이름만 기록한다).
#   로컬 값은 `supabase/seed/05_cron_service_user.sql`이 만드는 계정의 것이고,
#   운영 값은 **계정을 새로 만들지 않고** 민서 자신의 로그인 비밀번호를 Vercel
#   환경변수에만 넣는다(ⓐ′).
#
# ★★★ 그래서 운영에서 이 둘은 «사람 로그인 자격증명»과 같은 값이다 — 비밀번호를
#   바꾸면 이 변수도 함께 바꿔야 하고, 잊으면 배치가 조용히 죽는다(500이지만 로그
#   보존이 1시간이라 보이지 않고 감지는 `isStale`이 5일 뒤에 온다). 회전 계획이
#   없다는 것이 ⓐ′를 택한 근거다 — DOC-013 §5.1.
#
# 로컬에서는 아래 두 줄을 그대로 채우면 시드 계정으로 로그인한다.
CRON_SERVICE_EMAIL=
CRON_SERVICE_PASSWORD=
